# !!! IMPORTANT !!! Keep real secrets out of this file

# Save this file as .env and modify only after
MODEL_NAME=gpt-4o-mini
API_KEY=

# Leave BASE_URL empty to use OpenAI. To use an OpenAI-compatible provider instead
# (e.g. Groq), set it to that provider's endpoint, e.g.:
# MODEL_NAME=openai/gpt-oss-120b
# BASE_URL=https://api.groq.com/openai/v1
BASE_URL=

# Embedding model used for ingestion and retrieval (Hugging Face model id)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Where the parsed input HTML lives, and how many chunks to retrieve per question
INPUT_FILE=input/Legea nr.227_2015.html
VECTOR_DB_DIR=tmp/vector_db
RETRIEVER_TOP_K=5

# Arize Phoenix monitoring (leave PHOENIX_COLLECTOR_ENDPOINT empty to launch a local
# Phoenix instance automatically; set it to point at Phoenix Cloud or a remote collector)
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=ro-tax-advisor
ENABLE_TRACING=true
